{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    // 999 de propósito: o sistema real usa ClienteConnection_{GrupoId} com os
    // grupos 1..7, e um número alto não colide com cliente que venha a existir.
    "ClienteConnection_999": "Server=127.0.0.1;Port=3306;Database=erp_demo;Uid=demo;Pwd=demo;Connection Timeout=8;"
  },

  // O portal real resolve o token numa tabela do SQL Server. O demo não tem
  // SQL Server nem cadastro: o token vive aqui, e resolve para o grupo 999.
  // A FORMA é a mesma — token -> grupo -> string de conexão —, o que muda é de
  // onde vem o mapa. Assim o controller continua sendo cópia do original.
  "Demo": {
    "Token": "fazenda-demo",
    "GrupoId": 999,
    "NomeCliente": "Fazenda Crissiumal"
  }
}
