@model CeoManager.Models.InsumosBiViewModel
@{
    Layout = "_LayoutPublico";
    ViewBag.Titulo = "Insumos";
    ViewBag.AbaAtiva = "insumos";
}

<div class="d-flex justify-content-between align-items-center gap-2 mb-3 flex-wrap">
    <div>
        <div style="font-size:.7rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--green-700)">Relatório</div>
        <h1 class="mb-0" style="font-size:1.4rem;font-weight:800;color:var(--ink)">Custos de Insumos — Safra @(ViewBag.SafraSelecionada ?? "Atual")</h1>
    </div>
</div>

@if (ViewBag.ErroBanco != null)
{
    <div class="nota-agro is-perigo mb-3">
        <div class="nota-agro-titulo"><i class="fa-solid fa-triangle-exclamation me-2"></i> Falha de conexão</div>
        <div class="nota-agro-corpo">@ViewBag.ErroBanco</div>
    </div>
}

<!-- Filtros -->
<div class="card-agro filtros-agro mb-4">
    <div class="card-body">
        <form method="get">
            <div class="row g-3 align-items-end">
                <div class="col-12 col-md-3">
                    <label class="form-label fw-bold mb-1" style="color:var(--ink)">
                        <i class="fa-solid fa-calendar-days me-1" style="color:var(--green-600)"></i> Safra:
                    </label>
                    <select name="safra" class="form-select form-select-sm fw-bold shadow-none" onchange="this.form.submit()">
                        @* <option value="">-- Todas --</option> *@
                        @foreach (var s in ViewBag.SafrasDisponiveis)
                        {
                            <option value="@s" selected="@(s == ViewBag.SafraSelecionada)">@s</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-4">
                    <label class="form-label fw-bold mb-1" style="color:var(--ink)">
                        <i class="fa-solid fa-tractor me-1" style="color:var(--green-600)"></i> Fazenda:
                    </label>
                    <select name="fazenda" class="form-select form-select-sm fw-bold shadow-none" onchange="this.form.submit()">
                        <option value="">-- Todas --</option>
                        @foreach (var f in ViewBag.FazendasDisponiveis)
                        {
                            <option value="@f" selected="@(f == ViewBag.FazendaSelecionada)">@f</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-5">
                    <label class="form-label fw-bold mb-1" style="color:var(--ink)">
                        <i class="fa-solid fa-seedling me-1" style="color:var(--green-600)"></i> Cultura:
                    </label>
                    <div class="d-flex gap-2">
                        <select name="cultura" class="form-select form-select-sm fw-bold shadow-none" onchange="this.form.submit()">
                            <option value="">-- Todas --</option>
                            @foreach (var c in ViewBag.CulturasDisponiveis)
                            {
                                <option value="@c" selected="@(c == ViewBag.CulturaSelecionada)">@c</option>
                            }
                        </select>
                        @if (!string.IsNullOrEmpty(ViewBag.SafraSelecionada as string) || !string.IsNullOrEmpty(ViewBag.FazendaSelecionada as string) || !string.IsNullOrEmpty(ViewBag.CulturaSelecionada as string))
                        {
                            <a href="/p/insumos/@ViewBag.Token" class="btn btn-sm btn-agro-outline d-flex align-items-center">
                                <i class="fa-solid fa-rotate-left me-1"></i> Limpar
                            </a>
                        }
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- KPIs -->
<div class="row mb-4 row-metrics align-items-stretch">
    <div class="col-lg-3 col-md-6 mb-3 mb-lg-0">
        <div class="kpi kpi-1 h-100">
            <div class="d-flex justify-content-between align-items-center w-100">
                <div>
                    <h4>@Model.ValorTotalAplicacoes.ToString("C2", new System.Globalization.CultureInfo("pt-BR"))</h4>
                    <p>Valor Total das Aplicações</p>
                </div>
                <div class="kpi-ic"><i class="fa-solid fa-sack-dollar"></i></div>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-md-6 mb-3 mb-lg-0">
        <div class="kpi kpi-2 h-100">
            <div class="d-flex justify-content-between align-items-center w-100">
                <div>
                    <h4>@Model.CustoMedioReaisHa.ToString("C2", new System.Globalization.CultureInfo("pt-BR"))</h4>
                    <p>Custo Médio (R$ / HA)</p>
                </div>
                <div class="kpi-ic"><i class="fa-solid fa-money-bill-trend-up"></i></div>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-md-6 mb-3 mb-md-0">
        <div class="kpi kpi-3 h-100">
            <div class="d-flex justify-content-between align-items-center w-100">
                <div>
                    <h4>@Model.CustoMedioSacasHa.ToString("N2") <span>SC/HA</span></h4>
                    <p>Custo Médio (Sacas / HA)</p>
                </div>
                <div class="kpi-ic"><i class="fa-solid fa-wheat-awn"></i></div>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-md-6">
        <div class="kpi kpi-4 h-100">
            <div class="d-flex justify-content-between align-items-center w-100">
                <div>
                    <h4>@Model.RelacaoTrocaMedia.ToString("N2")<span>%</span></h4>
                    <p>Relação de Troca Média</p>
                </div>
                <div class="kpi-ic"><i class="fa-solid fa-right-left"></i></div>
            </div>
        </div>
    </div>
</div>

<!-- Gráficos -->
<div class="row mb-4 align-items-stretch">
    <div class="col-md-6 mb-3 mb-md-0">
        <div class="card-agro h-100 m-0" style="display: flex; flex-direction: column;">
            <div class="card-header py-3">
                <h3 class="card-title fs-6 m-0 fw-bold" style="color:var(--ink)"><i class="fa-solid fa-wheat-awn me-2" style="color:var(--green-600)"></i> Custo Total em Sacas (SC / HA) por Talhão</h3>
            </div>
            <div class="card-body p-3" style="position: relative; flex: 1 1 auto; min-height: 280px;">
                <canvas id="chartCustoSacas"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card-agro h-100 m-0" style="display: flex; flex-direction: column;">
            <div class="card-header py-3">
                <h3 class="card-title fs-6 m-0 fw-bold" style="color:var(--ink)"><i class="fa-solid fa-right-left me-2" style="color:var(--blue)"></i> Relação de Troca Realizada (%) por Talhão</h3>
            </div>
            <div class="card-body p-3" style="position: relative; flex: 1 1 auto; min-height: 280px;">
                <canvas id="chartRelacaoTroca"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Tabela pivô -->
<div class="row">
    <div class="col-12">
        <div class="card-agro">
            <div class="card-header py-3">
                <h3 class="card-title fs-5 m-0 fw-bold" style="color:var(--ink)">
                    <i class="fa-solid fa-table-cells me-2" style="color:var(--green-600)"></i> Distribuição de Custos por Talhão e Categoria de Insumo
                </h3>
            </div>
            <div class="card-body table-responsive p-0" style="max-height: 550px;">
                <table class="table table-sm table-hover table-pivot table-head-fixed text-nowrap table-agro">
                    <thead class="text-center">
                        <tr>
                            <th colspan="2" class="align-middle fw-bold" style="min-width: 250px;color:var(--ink)">CATEGORIA / MÉTRICA</th>
                            @foreach (var talhao in Model.ColunasTalhoes)
                            {
                                <th class="px-3">
                                    <div class="fw-bold" style="color:var(--ink)">@talhao</div>
                                    <div class="fw-normal" style="font-size: 0.75rem;color:var(--muted)">Área: @Model.AreasTalhoes[talhao].ToString("N1") HA</div>
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var tipo in Model.MatrizPivot.Keys)
                        {
                            <tr class="pivot-group border-top border-2">
                                <td colspan="@(Model.ColunasTalhoes.Count + 2)" class="py-2 ps-3">
                                    <i class="fa-solid fa-layer-group me-2" style="color:var(--green-600)"></i> @tipo
                                </td>
                            </tr>
                            <tr>
                                <td rowspan="3" class="text-center align-middle" style="width: 40px;background:#f6f9f7">
                                    <i class="fa-solid fa-circle-chevron-right fs-6" style="color:var(--muted)"></i>
                                </td>
                                <td class="row-metric-header ps-2">R$ / HA</td>
                                @foreach (var talhao in Model.ColunasTalhoes)
                                {
                                    var cel = Model.MatrizPivot[tipo][talhao];
                                    <td class="text-end fw-bold" style="color:var(--blue)">@(cel.CustoReaisHa > 0 ? cel.CustoReaisHa.ToString("N2") : "-")</td>
                                }
                            </tr>
                            <tr>
                                <td class="row-metric-header ps-2">SC / HA</td>
                                @foreach (var talhao in Model.ColunasTalhoes)
                                {
                                    var cel = Model.MatrizPivot[tipo][talhao];
                                    <td class="text-end fw-bold" style="color:var(--green-700)">@(cel.CustoSacasHa > 0 ? cel.CustoSacasHa.ToString("N2") : "-")</td>
                                }
                            </tr>
                            <tr>
                                <td class="row-metric-header ps-2">TROCA (%)</td>
                                @foreach (var talhao in Model.ColunasTalhoes)
                                {
                                    var cel = Model.MatrizPivot[tipo][talhao];
                                    <td class="text-end fw-bold" style="color:var(--danger)">@(cel.RelacaoTroca > 0 ? cel.RelacaoTroca.ToString("N2") + "%" : "-")</td>
                                }
                            </tr>
                        }
                    </tbody>
                    <tfoot class="border-top border-3">
                        <tr>
                            <td rowspan="3" class="text-center align-middle fw-bold" style="color:var(--ink)">TOTAL</td>
                            <td class="row-metric-header fw-bold ps-2" style="color:var(--ink)">Total R$ / HA</td>
                            @foreach (var talhao in Model.ColunasTalhoes)
                            {
                                <td class="text-end fw-bold fs-6" style="color:var(--blue)">@Model.TotaisPorTalhao[talhao].CustoReaisHa.ToString("N2")</td>
                            }
                        </tr>
                        <tr>
                            <td class="row-metric-header fw-bold ps-2" style="color:var(--ink)">Total SC / HA</td>
                            @foreach (var talhao in Model.ColunasTalhoes)
                            {
                                <td class="text-end fw-bold fs-6" style="color:var(--green-700)">@Model.TotaisPorTalhao[talhao].CustoSacasHa.ToString("N2")</td>
                            }
                        </tr>
                        <tr>
                            <td class="row-metric-header fw-bold ps-2" style="color:var(--ink)">Total TROCA (%)</td>
                            @foreach (var talhao in Model.ColunasTalhoes)
                            {
                                <td class="text-end fw-bold fs-6" style="color:var(--danger)">@Model.TotaisPorTalhao[talhao].RelacaoTroca.ToString("N2")%</td>
                            }
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        Chart.defaults.color = '#6b7f72';
        Chart.defaults.borderColor = '#e6ede8';
        Chart.defaults.font.family = "'Inter', system-ui, sans-serif";

        const labelsTalhoes = @Html.Raw(Json.Serialize(Model.ChartLabelsTalhoes));

        function barraGradiente(context) {
            var chart = context.chart, area = chart.chartArea;
            if (!area) { return '#1a8552'; }
            var g = chart.ctx.createLinearGradient(0, area.top, 0, area.bottom);
            g.addColorStop(0, '#4cc088'); g.addColorStop(1, '#146c43');
            return g;
        }

        function barraGradienteAzul(context) {
            var chart = context.chart, area = chart.chartArea;
            if (!area) { return '#1e4a7b'; }
            var g = chart.ctx.createLinearGradient(0, area.top, 0, area.bottom);
            g.addColorStop(0, '#3d6ea5'); g.addColorStop(1, '#1e4a7b');
            return g;
        }

        new Chart(document.getElementById('chartCustoSacas').getContext('2d'), {
            type: 'bar',
            data: {
                labels: labelsTalhoes,
                datasets: [{
                    label: 'Custo Realizado (SC/HA)',
                    data: @Html.Raw(Json.Serialize(Model.ChartCustoSacas)),
                    backgroundColor: barraGradiente, hoverBackgroundColor: '#0b3d2c',
                    borderWidth: 0, borderRadius: 7, borderSkipped: false, barPercentage: 0.5
                }]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                plugins: { legend: { display: false }, tooltip: { backgroundColor: '#0b3d2c', padding: 12, cornerRadius: 10 } },
                scales: {
                    x: { grid: { display: false }, ticks: { font: { size: 10 } } },
                    y: { beginAtZero: true, title: { display: true, text: 'SC / HA', font: { size: 11, weight: 'bold' } }, grid: { color: 'rgba(11,61,44,0.06)' } }
                }
            }
        });

        new Chart(document.getElementById('chartRelacaoTroca').getContext('2d'), {
            type: 'bar',
            data: {
                labels: labelsTalhoes,
                datasets: [{
                    label: 'Relação de Troca (%)',
                    data: @Html.Raw(Json.Serialize(Model.ChartRelacaoTroca)),
                    backgroundColor: barraGradienteAzul, hoverBackgroundColor: '#0e2f52',
                    borderWidth: 0, borderRadius: 7, borderSkipped: false, barPercentage: 0.5
                }]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: { backgroundColor: '#0b3d2c', padding: 12, cornerRadius: 10, callbacks: { label: function(c) { return 'Troca: ' + c.raw.toFixed(2) + '%'; } } }
                },
                scales: {
                    x: { grid: { display: false }, ticks: { font: { size: 10 } } },
                    y: { beginAtZero: true, title: { display: true, text: 'Porcentagem (%)', font: { size: 11, weight: 'bold' } }, grid: { color: 'rgba(11,61,44,0.06)' }, ticks: { callback: function(v) { return v + '%'; } } }
                }
            }
        });
    </script>
}