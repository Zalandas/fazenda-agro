@model IEnumerable<CeoManager.Models.ProducaoPublicaViewModel>
@{
    Layout = "_LayoutPublico";
    ViewBag.Titulo = "Produção";
    ViewBag.AbaAtiva = "producao";
    ViewBag.SubAba = "producao";
    var maxProdutividade = (Model != null && Model.Any()) ? Model.Max(x => x.Produtividade) : 0m;
}

<div class="d-flex justify-content-between align-items-center gap-2 mb-3 flex-wrap">
    <div>
        <div style="font-size:.7rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--green-700)">Relatório</div>
        <h1 class="mb-0" style="font-size:1.4rem;font-weight:800;color:var(--ink)">Produção — Safra @(ViewBag.SafraSelecionada ?? "Atual")</h1>
    </div>
</div>

<partial name="_AbasProducao" />

@if (ViewBag.ErroBanco != null)
{
    <div class="nota-agro is-perigo mb-3">
        <div class="nota-agro-titulo"><i class="fa-solid fa-triangle-exclamation me-2"></i> Falha de conexão</div>
        <div class="nota-agro-corpo">@ViewBag.ErroBanco</div>
    </div>
}

<!-- Filtros -->
<div class="card-agro filtros-agro mb-3">
    <div class="card-body">
        <form method="get" id="formFiltrosPublicos">
            <div class="row g-3 align-items-end">

                <div class="col-12 col-md-2">
                    <label class="form-label fw-bold mb-1" style="color:var(--ink)">
                        <i class="fa-solid fa-calendar-days me-1" style="color:var(--green-600)"></i> Safra:
                    </label>
                    <select name="safra" class="form-select form-select-sm fw-bold shadow-none" onchange="this.form.submit()">
                        @* <option value="">-- Todas --</option> *@
                        @if (ViewBag.SafrasDisponiveis != null)
                        {
                            foreach (var s in ViewBag.SafrasDisponiveis)
                            {
                                <option value="@s" selected="@(s == ViewBag.SafraSelecionada)">@s</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-12 col-md-2">
                    <label class="form-label fw-bold mb-1" style="color:var(--ink)">
                        <i class="fa-solid fa-rotate me-1" style="color:var(--green-600)"></i> Ciclo:
                    </label>
                    <select name="ciclo" class="form-select form-select-sm fw-bold shadow-none" onchange="this.form.submit()">
                        <option value="">-- Todos --</option>
                        @if (ViewBag.CiclosDisponiveis != null)
                        {
                            foreach (var c in ViewBag.CiclosDisponiveis)
                            {
                                <option value="@c" selected="@(c == ViewBag.CicloSelecionado)">@c</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-12 col-md-3">
                    <label class="form-label fw-bold mb-1" style="color:var(--ink)">
                        <i class="fa-solid fa-tractor me-1" style="color:var(--green-600)"></i> Fazenda:
                    </label>
                    <select name="fazenda" class="form-select form-select-sm fw-bold shadow-none" onchange="this.form.submit()">
                        <option value="">-- Todas --</option>
                        @if (ViewBag.FazendasDisponiveis != null)
                        {
                            foreach (var f in ViewBag.FazendasDisponiveis)
                            {
                                <option value="@f" selected="@(f == ViewBag.FazendaSelecionada)">@f</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-12 col-md-2">
                    <label class="form-label fw-bold mb-1" style="color:var(--ink)">
                        <i class="fa-solid fa-seedling me-1" style="color:var(--green-600)"></i> Cultura:
                    </label>
                    <select name="cultura" class="form-select form-select-sm fw-bold shadow-none" onchange="this.form.submit()">
                        <option value="">-- Todas --</option>
                        @if (ViewBag.CulturasDisponiveis != null)
                        {
                            foreach (var c in ViewBag.CulturasDisponiveis)
                            {
                                <option value="@c" selected="@(c == ViewBag.CulturaSelecionada)">@c</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-12 col-md-2">
                    <label class="form-label fw-bold mb-1" style="color:var(--ink)">
                        <i class="fa-solid fa-leaf me-1" style="color:var(--green-600)"></i> Cultivar:
                    </label>
                    <select name="cultivar" class="form-select form-select-sm fw-bold shadow-none" onchange="this.form.submit()">
                        <option value="">-- Todas --</option>
                        @if (ViewBag.CultivaresDisponiveis != null)
                        {
                            foreach (var cv in ViewBag.CultivaresDisponiveis)
                            {
                                <option value="@cv" selected="@(cv == (string)ViewBag.CultivarSelecionada)">@cv</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-auto">
                    @if (!string.IsNullOrEmpty(ViewBag.SafraSelecionada as string)
                                        || !string.IsNullOrEmpty(ViewBag.CicloSelecionado as string)
                                        || !string.IsNullOrEmpty(ViewBag.FazendaSelecionada as string)
                                        || !string.IsNullOrEmpty(ViewBag.CulturaSelecionada as string)
                                        || !string.IsNullOrEmpty(ViewBag.CultivarSelecionada as string))
                    {
                        <a href="/p/producao/@ViewBag.Token" class="btn btn-sm btn-agro-outline d-flex align-items-center">
                            <i class="fa-solid fa-rotate-left me-1"></i> Limpar
                        </a>
                    }
                </div>

            </div>
        </form>
    </div>
</div>

<!-- Cards + gráfico -->
<div class="row align-items-stretch row-main-dashboard">

    <div class="col-lg-3 col-md-4 mb-3">
        <div class="row h-100 row-metrics">

            <div class="col-12 mb-2">
                <div class="kpi kpi-1 h-100">
                    <div class="d-flex justify-content-between align-items-center w-100">
                        <div>
                            <h4 style="font-size:1.5rem;">@(((decimal)(ViewBag.AreaTotal ?? 0m)).ToString("N2")) <span>HA</span></h4>
                            <p class="mb-1">Área Total Plantada</p>
                            <h4 style="font-size:1.5rem;">@(((decimal)(ViewBag.AreaColhida ?? 0m)).ToString("N2")) <span>HA</span></h4>
                            <p>Área Total Colhida</p>
                        </div>
                        <div class="text-center">
                            <div class="fw-bold" style="font-size:1.5rem; line-height:1;">@(((decimal)(ViewBag.PercentualColhido ?? 0m)).ToString("N1"))%</div>
                            <div style="font-size:0.7rem; opacity:0.8;">COLHIDO</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 mb-2">
                <div class="kpi kpi-2 h-100">
                    <div class="d-flex justify-content-between align-items-center w-100">
                        <div>
                            <h4 style="font-size:1.5rem;">@(((decimal)(ViewBag.ProducaoTotalSc ?? 0m)).ToString("N0")) <span>SC</span></h4>
                            <p class="mb-1">Produção Total</p>
                            <h4 style="font-size:1.5rem;">@(((decimal)(ViewBag.ProducaoColhidaSc ?? 0m)).ToString("N0")) <span>SC</span></h4>
                            <p>Produção Colhida</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12">
                <div class="kpi kpi-3 h-100">
                    <div class="d-flex justify-content-between align-items-center w-100">
                        <div>
                            <h4 style="font-size:1.5rem;">@(((decimal)(ViewBag.ProdutividadeGeral ?? 0m)).ToString("N2")) <span>SC/HA</span></h4>
                            <p class="mb-1">Produtividade Geral</p>
                            <h4 style="font-size:1.5rem;">@(((decimal)(ViewBag.ProdutividadeColhida ?? 0m)).ToString("N2")) <span>SC/HA</span></h4>
                            <p>Produtividade Colhida</p>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <div class="col-lg-9 col-md-8 mb-3">
        <div class="card-agro h-100 m-0" style="display: flex; flex-direction: column;">
            <div class="card-header py-2 d-flex align-items-center justify-content-between flex-wrap gap-2">
                <h3 class="card-title fs-6 m-0 fw-bold" style="color:var(--ink)">
                    <i class="fa-solid fa-chart-column me-2" style="color:var(--green-600)"></i>
                    <span id="tituloGrafico">Produtividade Realizada (SC/HA) por Talhão</span>
                </h3>
                <div class="btn-group btn-group-sm" role="group">
                    <button type="button" class="btn btn-agro-outline active" id="btnPorTalhao" onclick="trocarGrafico('talhao')">Por Talhão</button>
                    <button type="button" class="btn btn-agro-outline" id="btnPorCultivar" onclick="trocarGrafico('cultivar')">Por Cultivar</button>
                </div>
            </div>
            <div class="card-body p-2" style="position: relative; min-height: 280px; flex: 1 1 auto;">
                <canvas id="graficoProducao"></canvas>
                <canvas id="graficoCultivar" style="display: none;"></canvas>
            </div>
        </div>
    </div>

</div>

<!-- Tabela -->
<div class="row mt-4">
    <div class="col-12">
        <div class="card-agro">
            <div class="card-header py-3 d-flex justify-content-between align-items-center">
                <h3 class="card-title fs-5 m-0 fw-bold" style="color:var(--ink)">
                    <i class="fa-solid fa-table me-2" style="color:var(--green-600)"></i> Espelho de Talhões
                </h3>
            </div>
            <div class="card-body table-responsive p-0" style="max-height: 500px;">
                <table class="table table-sm table-hover table-head-fixed text-nowrap table-agro">
                    <thead>
                        <tr class="text-center align-middle">
                            <th class="text-start ps-3">FAZENDA</th>
                            <th>TALHÃO</th>
                            <th>CULTURA</th>
                            <th>CULTIVAR</th>
                            <th class="text-end">ÁREA PLANTADA (HA)</th>
                            <th class="text-end">ÁREA COLHIDA (HA)</th>
                            <th class="text-end">TOTAL DE SACAS</th>
                            <th class="text-end pe-3">PRODUTIVIDADE (SC/HA)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr><td colspan="8" class="text-center py-4" style="color:var(--muted)">Nenhum dado para os filtros aplicados.</td></tr>
                        }
                        @foreach (var item in Model)
                        {
                            <tr class="align-middle">
                                <td class="fw-bold ps-3" style="color:var(--ink)">@item.Fazenda</td>
                                <td class="text-center"><span class="talhao-badge">@item.Talhao</span></td>
                                <td class="text-center" style="color:var(--ink-2)">@item.Cultura</td>
                                <td class="text-center" style="color:var(--ink-2)">@item.Cultivar</td>
                                <td class="text-end fw-bold" style="color:var(--ink)">@item.AreaPlantada.ToString("N2")</td>
                                <td class="text-end" style="color:var(--ink-2)">@item.AreaColhida.ToString("N2")</td>
                                <td class="text-end sc-cell">@item.TotalProduzidoSacas.ToString("N2")</td>
                                <td class="text-end pe-3">
                                    <span class="prod-cell">@item.Produtividade.ToString("N2")</span>
                                    @{
                                        var larguraProd = maxProdutividade > 0 ? (item.Produtividade / maxProdutividade) * 100 : 0m;
                                        var estiloBarra = $"width:{larguraProd.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}%";
                                    }
                                    <div class="barra-prod"><span style="@estiloBarra"></span></div>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="align-middle tabela-total">
                            <td colspan="4" class="text-end pe-3 fw-bold" style="color:var(--ink)">TOTAIS</td>
                            <td class="text-end fw-bold" style="color:var(--ink)">@(((decimal)(ViewBag.AreaTotal ?? 0m)).ToString("N2"))</td>
                            <td class="text-end" style="color:var(--ink-2)">@(((decimal)(ViewBag.AreaColhida ?? 0m)).ToString("N2"))</td>
                            <td class="text-end sc-cell">@(((decimal)(ViewBag.ProducaoTotalSc ?? 0m)).ToString("N2"))</td>
                            <td class="text-end pe-3 fw-bold" style="color:var(--ink)">@(((decimal)(ViewBag.ProdutividadeGeral ?? 0m)).ToString("N2"))</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        Chart.defaults.color = '#6b7f72';
        Chart.defaults.borderColor = '#e6ede8';
        Chart.defaults.font.family = "'Inter', system-ui, sans-serif";

        function barraGradiente(context) {
            var chart = context.chart;
            var area = chart.chartArea;
            if (!area) { return '#1a8552'; }
            var g = chart.ctx.createLinearGradient(0, area.top, 0, area.bottom);
            g.addColorStop(0, '#4cc088');
            g.addColorStop(1, '#146c43');
            return g;
        }

        var ctx = document.getElementById('graficoProducao').getContext('2d');
        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: @Html.Raw(Json.Serialize(ViewBag.ChartTalhoes)),
                datasets: [{
                    label: 'Produtividade (SC/HA)',
                    data: @Html.Raw(Json.Serialize(ViewBag.ChartProdutividades)),
                    backgroundColor: barraGradiente,
                    hoverBackgroundColor: '#0b3d2c',
                    borderWidth: 0, borderRadius: 7, borderSkipped: false, barPercentage: 0.6
                }]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: '#0b3d2c', padding: 12, cornerRadius: 10,
                        callbacks: { label: function(context) { return 'Produtividade: ' + context.raw.toLocaleString('pt-BR', { minimumFractionDigits: 2 }) + ' SC/HA'; } }
                    }
                },
                scales: {
                    x: { grid: { display: false }, ticks: { font: { size: 10, weight: '600' } } },
                    y: {
                        beginAtZero: true,
                        title: { display: true, text: 'SC / HA', font: { size: 11, weight: 'bold' } },
                        grid: { color: 'rgba(11,61,44,0.06)' }, ticks: { font: { size: 10 } }
                    }
                }
            }
        });

        var ctxCultivar = document.getElementById('graficoCultivar').getContext('2d');
        var chartCultivar = new Chart(ctxCultivar, {
            type: 'bar',
            data: {
                labels: @Html.Raw(Json.Serialize(ViewBag.ChartCultivares)),
                datasets: [{
                    label: 'Produtividade (SC/HA)',
                    data: @Html.Raw(Json.Serialize(ViewBag.ChartCultivarProdutividades)),
                    backgroundColor: '#1a8552', borderRadius: 6
                }]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true, title: { display: true, text: 'SC / HA' } } }
            }
        });

        const CHAVE_VISAO = 'producao_publica_visao_grafico';

        function trocarGrafico(tipo) {
            var gTalhao = document.getElementById('graficoProducao');
            var gCultivar = document.getElementById('graficoCultivar');
            var titulo = document.getElementById('tituloGrafico');
            var btnT = document.getElementById('btnPorTalhao');
            var btnC = document.getElementById('btnPorCultivar');

            if (tipo === 'cultivar') {
                gTalhao.style.display = 'none';
                gCultivar.style.display = 'block';
                titulo.textContent = 'Produtividade Realizada (SC/HA) por Cultivar';
                btnC.classList.add('active');
                btnT.classList.remove('active');
                chartCultivar.resize();
            } else {
                gTalhao.style.display = 'block';
                gCultivar.style.display = 'none';
                titulo.textContent = 'Produtividade Realizada (SC/HA) por Talhão';
                btnT.classList.add('active');
                btnC.classList.remove('active');
            }
            sessionStorage.setItem(CHAVE_VISAO, tipo);
        }

        const salva = sessionStorage.getItem(CHAVE_VISAO);
        if (salva && salva !== 'talhao') {
            trocarGrafico(salva);
        }
    </script>
}