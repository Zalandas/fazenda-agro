@{
    var token = ViewBag.Token as string;
    var sub = ViewBag.SubAba as string;
}
<ul class="nav nav-tabs mb-3">
    <li class="nav-item">
        <a class="nav-link @(sub == "romaneios" ? "" : "active")" href="/p/producao/@token">
            <i class="fa-solid fa-chart-column me-1"></i> Produção
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(sub == "romaneios" ? "active" : "")" href="/p/romaneios/@token">
            <i class="fa-solid fa-list me-1"></i> Romaneios
        </a>
    </li>
</ul>